import React, { useState } from 'react';
import { useUser } from '../context/UserContext.js';
import { useTheme } from '../context/ThemeContext.js';
import { ExamMode } from '../types/index.js';

export const AuthPage: React.FC = () => {
  const { login, register, loading } = useUser();
  const { theme, toggleTheme } = useTheme();

  // Page view: 'hero' (Landing showcase) | 'login' (Centered login card) | 'register' (Centered register card)
  const [currentView, setCurrentView] = useState<'hero' | 'login' | 'register'>('hero');

  // Login form state
  const [loginEmail, setLoginEmail] = useState('');
  const [loginPassword, setLoginPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [rememberMe, setRememberMe] = useState(true);

  // Register form state
  const [regName, setRegName] = useState('');
  const [regEmail, setRegEmail] = useState('');
  const [regPassword, setRegPassword] = useState('');
  const [regTargetBand, setRegTargetBand] = useState('7.5 Academic');
  const [regExamDate, setRegExamDate] = useState('2025-11-15');
  const [regMode, setRegMode] = useState<ExamMode>('IELTS');

  // Feedback messages
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [successMessage, setSuccessMessage] = useState<string | null>(null);

  const handleLoginSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMessage(null);

    if (!loginEmail.trim()) {
      setErrorMessage('Iltimos, email manzilingizni kiriting.');
      return;
    }

    const success = await login(loginEmail, loginPassword);
    if (success) {
      setSuccessMessage("Tizimga muvaffaqiyatli kirildi. Yo'naltirilmoqda...");
    } else {
      setErrorMessage("Email yoki parol noto'g'ri. Qayta urinib ko'ring.");
    }
  };

  const handleRegisterSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMessage(null);

    if (!regName.trim()) {
      setErrorMessage('Iltimos, to‘liq ismingizni kiriting.');
      return;
    }
    if (!regEmail.trim()) {
      setErrorMessage('Iltimos, email manzilingizni kiriting.');
      return;
    }
    if (regPassword.length < 6) {
      setErrorMessage('Parol kamida 6 ta belgidan iborat bo‘lishi kerak.');
      return;
    }

    const success = await register({
      name: regName.trim(),
      email: regEmail.trim(),
      targetBand: regTargetBand,
      examDate: regExamDate,
      activeExamMode: regMode,
      password: regPassword,
    });

    if (success) {
      setSuccessMessage("Profilingiz muvaffaqiyatli yaratildi. Xush kelibsiz!");
    } else {
      setErrorMessage("Ro'yxatdan o'tishda xatolik yuz berdi. Qayta urinib ko'ring.");
    }
  };

  // Quick Demo Access
  const handleQuickDemo = (name: string, email: string) => {
    setLoginEmail(email);
    setLoginPassword('demo12345');
    login(email, 'demo12345').then(() => {
      setSuccessMessage(`${name} sifatida kirildi. Xush kelibsiz!`);
    });
  };

  // Google OAuth simulation
  const handleGoogleSignIn = () => {
    handleQuickDemo('Mansur Toshmatov', 'mansur@ieltix.uz');
  };

  return (
    <div className="min-h-screen bg-[#090D16] text-slate-100 flex flex-col justify-between font-sans selection:bg-blue-600/30 selection:text-blue-200 relative overflow-x-hidden">
      
      {/* Soft, calm background gradient — zero harsh neon */}
      <div className="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(37,99,235,0.08),transparent)] pointer-events-none" />
      <div className="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_100%,rgba(30,41,59,0.2),transparent)] pointer-events-none" />

      {/* 1. Minimalist Top Navigation */}
      <header className="w-full border-b border-slate-800/60 bg-[#090D16]/80 backdrop-blur-md sticky top-0 z-40">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          
          {/* Brand Mark */}
          <button 
            type="button" 
            onClick={() => { setCurrentView('hero'); setErrorMessage(null); }} 
            className="flex items-center gap-3 group text-left cursor-pointer"
          >
            <div className="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center overflow-hidden p-1 transition-transform group-hover:scale-105">
              <img
                src="/ieltix-logo.png"
                alt="IELTIX"
                className="w-full h-full object-cover rounded-lg"
              />
            </div>
            <div>
              <div className="flex items-center gap-1.5">
                <span className="font-semibold text-lg tracking-tight text-white">
                  IELTIX
                </span>
                <span className="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                  AI
                </span>
              </div>
            </div>
          </button>

          {/* Navigation Links (Desktop) */}
          <nav className="hidden md:flex items-center gap-7 text-sm font-medium text-slate-400">
            <button 
              type="button"
              onClick={() => setCurrentView('hero')}
              className={`hover:text-white transition-colors cursor-pointer ${currentView === 'hero' ? 'text-white' : ''}`}
            >
              Asosiy
            </button>
            <button 
              type="button"
              onClick={() => setCurrentView('hero')}
              className="hover:text-white transition-colors cursor-pointer"
            >
              Imkoniyatlar
            </button>
            <button 
              type="button"
              onClick={() => setCurrentView('hero')}
              className="hover:text-white transition-colors cursor-pointer"
            >
              Baholash tizimi
            </button>
          </nav>

          {/* Action Controls */}
          <div className="flex items-center gap-3">
            <button
              type="button"
              onClick={toggleTheme}
              title={theme === 'dark' ? 'Kunduzgi rejim' : 'Tungi rejim'}
              className="w-9 h-9 rounded-xl bg-slate-800/60 hover:bg-slate-800 border border-slate-700/50 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer"
            >
              <span className="material-symbols-outlined text-[18px]">
                {theme === 'dark' ? 'light_mode' : 'dark_mode'}
              </span>
            </button>

            {currentView === 'hero' ? (
              <button
                type="button"
                onClick={() => { setCurrentView('login'); setErrorMessage(null); }}
                className="px-4 py-2 rounded-xl text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-all cursor-pointer shadow-sm"
              >
                Kirish
              </button>
            ) : (
              <button
                type="button"
                onClick={() => { setCurrentView('hero'); setErrorMessage(null); }}
                className="px-3.5 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all cursor-pointer"
              >
                Asosiy sahifa
              </button>
            )}
          </div>
        </div>
      </header>

      {/* 2. Main Content Area */}
      <main className="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-10 sm:py-16 relative z-10">
        
        {/* ========================================================================= */}
        {/* VIEW 1: HERO / BANNER SECTION (Landing View) */}
        {/* ========================================================================= */}
        {currentView === 'hero' && (
          <div className="max-w-6xl w-full mx-auto space-y-16 animate-fadeIn">
            
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
              
              {/* Left Content (7 cols) */}
              <div className="lg:col-span-7 space-y-6 text-left">
                
                {/* Subtle Pill Badge */}
                <div className="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-800/70 border border-slate-700/70 text-slate-300 text-xs font-medium">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-400" />
                  <span>Cambridge va Milliy BBM Standartlari</span>
                </div>

                {/* Main Headline */}
                <h1 className="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.2]">
                  IELTS natijasiga <br />
                  <span className="text-blue-400">aniq va samarali</span> tayyorlaning
                </h1>

                {/* Supporting Text */}
                <p className="text-base sm:text-lg text-slate-400 leading-relaxed max-w-xl font-normal">
                  Real vaqtdagi AI Examiner bilan ovozli intervyu o‘tkazing, Task 1 va Task 2 insholaringizni Cambridge mezonlari bo‘yicha batafsil tahlil qiling.
                </p>

                {/* Two Clear CTA Buttons */}
                <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
                  <button
                    type="button"
                    onClick={() => { setCurrentView('register'); setErrorMessage(null); }}
                    className="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all shadow-md shadow-blue-600/10 flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <span>Bepul boshlash</span>
                    <span className="material-symbols-outlined text-base">arrow_forward</span>
                  </button>

                  <button
                    type="button"
                    onClick={() => handleQuickDemo('Mansur Toshmatov', 'mansur@ieltix.uz')}
                    className="px-6 py-3 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700/70 text-slate-200 font-medium text-sm transition-all flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <span>Demo sinovni ko'rish</span>
                    <span className="material-symbols-outlined text-base text-slate-400">play_circle</span>
                  </button>
                </div>

                {/* Trust Points */}
                <div className="flex items-center gap-6 pt-4 text-xs text-slate-400">
                  <div className="flex items-center gap-2">
                    <span className="material-symbols-outlined text-emerald-400 text-base">check_circle</span>
                    <span>Karta talab qilinmaydi</span>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="material-symbols-outlined text-emerald-400 text-base">check_circle</span>
                    <span>24/7 AI Examiner faol</span>
                  </div>
                </div>

              </div>

              {/* Right Side: Elegant, Calm Preview Card (5 cols) */}
              <div className="lg:col-span-5">
                <div className="rounded-2xl bg-[#101625] border border-slate-800 p-6 shadow-xl shadow-black/25 space-y-5">
                  
                  {/* Card Header */}
                  <div className="flex items-center justify-between border-b border-slate-800/80 pb-4">
                    <div className="flex items-center gap-3">
                      <img
                        src="/ai-examiner.png"
                        alt="AI Examiner"
                        className="w-11 h-11 rounded-xl object-cover border border-slate-700/60"
                      />
                      <div>
                        <h4 className="text-sm font-semibold text-white">AI Examiner</h4>
                        <span className="text-xs text-slate-400">Speaking & Writing Diagnostic</span>
                      </div>
                    </div>
                    <span className="px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      Band 8.5
                    </span>
                  </div>

                  {/* Criteria Evaluation List */}
                  <div className="space-y-3 text-xs">
                    <div className="p-3 rounded-xl bg-slate-800/40 border border-slate-800/60 flex items-center justify-between">
                      <div>
                        <span className="text-slate-400 block text-[11px]">Fluency & Coherence</span>
                        <span className="font-semibold text-slate-200">Ravon va mantiqiy nutq</span>
                      </div>
                      <span className="font-bold text-blue-400 text-sm">8.5</span>
                    </div>

                    <div className="p-3 rounded-xl bg-slate-800/40 border border-slate-800/60 flex items-center justify-between">
                      <div>
                        <span className="text-slate-400 block text-[11px]">Lexical Resource</span>
                        <span className="font-semibold text-slate-200">C1/C2 darajadagi akademik lug‘at</span>
                      </div>
                      <span className="font-bold text-blue-400 text-sm">9.0</span>
                    </div>

                    <div className="p-3 rounded-xl bg-slate-800/40 border border-slate-800/60 flex items-center justify-between">
                      <div>
                        <span className="text-slate-400 block text-[11px]">Grammatical Range</span>
                        <span className="font-semibold text-slate-200">Murakkab grammatik strukturalar</span>
                      </div>
                      <span className="font-bold text-blue-400 text-sm">8.0</span>
                    </div>
                  </div>

                  {/* Fast Action Inside Card */}
                  <button
                    type="button"
                    onClick={() => { setCurrentView('login'); setErrorMessage(null); }}
                    className="w-full py-2.5 rounded-xl bg-blue-600/10 hover:bg-blue-600/20 border border-blue-500/20 text-blue-400 text-xs font-medium transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
                  >
                    <span>Imtihon topshirish uchun kiring</span>
                    <span className="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>

                </div>
              </div>

            </div>

            {/* Feature Highlights Grid */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4 border-t border-slate-800/60">
              <div className="p-4 rounded-xl bg-[#0F1422] border border-slate-800/80 text-left space-y-1.5">
                <div className="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                  <span className="material-symbols-outlined text-lg">record_voice_over</span>
                </div>
                <h3 className="text-sm font-semibold text-white">AI Speaking</h3>
                <p className="text-xs text-slate-400 leading-relaxed">Part 1, 2, 3 bo‘yicha interaktiv real vaqtdagi ovozli imtihon.</p>
              </div>

              <div className="p-4 rounded-xl bg-[#0F1422] border border-slate-800/80 text-left space-y-1.5">
                <div className="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                  <span className="material-symbols-outlined text-lg">edit_note</span>
                </div>
                <h3 className="text-sm font-semibold text-white">Writing Assessment</h3>
                <p className="text-xs text-slate-400 leading-relaxed">Task 1 va Task 2 insholarini rasmiy kriteriyalar bo‘yicha tekshirish.</p>
              </div>

              <div className="p-4 rounded-xl bg-[#0F1422] border border-slate-800/80 text-left space-y-1.5">
                <div className="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                  <span className="material-symbols-outlined text-lg">menu_book</span>
                </div>
                <h3 className="text-sm font-semibold text-white">Reading & Vocab</h3>
                <p className="text-xs text-slate-400 leading-relaxed">Ilmiy matnlar va bir bosishda yangi C1/C2 so‘zlarni lug‘atga saqlash.</p>
              </div>

              <div className="p-4 rounded-xl bg-[#0F1422] border border-slate-800/80 text-left space-y-1.5">
                <div className="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center">
                  <span className="material-symbols-outlined text-lg">headphones</span>
                </div>
                <h3 className="text-sm font-semibold text-white">Listening Lab</h3>
                <p className="text-xs text-slate-400 leading-relaxed">Rasmiy britaniya va xalqaro talaffuzlar bilan to‘liq audio amaliyot.</p>
              </div>
            </div>

          </div>
        )}

        {/* ========================================================================= */}
        {/* VIEW 2: CLEAN CENTERED LOGIN CARD */}
        {/* ========================================================================= */}
        {currentView === 'login' && (
          <div className="w-full max-w-md mx-auto animate-fadeIn">
            
            {/* Centered Login Card */}
            <div className="rounded-2xl bg-[#111726] border border-slate-800 p-6 sm:p-8 shadow-2xl shadow-black/40 space-y-6 text-left">
              
              {/* Card Header */}
              <div className="text-center space-y-1.5">
                <h2 className="text-2xl font-bold tracking-tight text-white">
                  Tizimga kirish
                </h2>
                <p className="text-xs text-slate-400">
                  IELTIX platformasidagi hisobingizga kiring
                </p>
              </div>

              {/* Feedback Alerts */}
              {errorMessage && (
                <div className="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs flex items-center gap-2">
                  <span className="material-symbols-outlined text-base shrink-0">error</span>
                  <span>{errorMessage}</span>
                </div>
              )}

              {successMessage && (
                <div className="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center gap-2">
                  <span className="material-symbols-outlined text-base shrink-0">check_circle</span>
                  <span>{successMessage}</span>
                </div>
              )}

              {/* Continue with Google Button */}
              <button
                type="button"
                onClick={handleGoogleSignIn}
                className="w-full py-2.5 px-4 rounded-xl bg-slate-800/80 hover:bg-slate-800 border border-slate-700/80 text-white font-medium text-xs sm:text-sm flex items-center justify-center gap-3 transition-colors cursor-pointer"
              >
                <svg className="w-4 h-4 shrink-0" viewBox="0 0 24 24">
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                  />
                </svg>
                <span>Google orqali davom etish</span>
              </button>

              {/* Minimal Divider */}
              <div className="relative flex items-center justify-center">
                <div className="border-t border-slate-800 w-full" />
                <span className="bg-[#111726] px-3 text-[11px] text-slate-500 uppercase tracking-wider font-medium">
                  yoki email bilan
                </span>
              </div>

              {/* Minimal Login Form */}
              <form onSubmit={handleLoginSubmit} className="space-y-4">
                
                {/* Email Field */}
                <div className="space-y-1.5">
                  <label className="text-xs font-medium text-slate-300 block">
                    Email manzili
                  </label>
                  <input
                    type="email"
                    required
                    value={loginEmail}
                    onChange={(e) => setLoginEmail(e.target.value)}
                    placeholder="nomzod@example.com"
                    className="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                </div>

                {/* Password Field */}
                <div className="space-y-1.5">
                  <label className="text-xs font-medium text-slate-300 block">
                    Parol
                  </label>
                  <div className="relative">
                    <input
                      type={showPassword ? 'text' : 'password'}
                      required
                      value={loginPassword}
                      onChange={(e) => setLoginPassword(e.target.value)}
                      placeholder="••••••••"
                      className="w-full pl-3.5 pr-10 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                    />
                    <button
                      type="button"
                      onClick={() => setShowPassword(!showPassword)}
                      className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200 transition-colors cursor-pointer"
                    >
                      <span className="material-symbols-outlined text-[18px]">
                        {showPassword ? 'visibility_off' : 'visibility'}
                      </span>
                    </button>
                  </div>
                </div>

                {/* Remember Me & Forgot Password */}
                <div className="flex items-center justify-between text-xs pt-0.5">
                  <label className="flex items-center gap-2 cursor-pointer select-none text-slate-400 hover:text-slate-300">
                    <input
                      type="checkbox"
                      checked={rememberMe}
                      onChange={(e) => setRememberMe(e.target.checked)}
                      className="rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer"
                    />
                    <span>Eslab qolish</span>
                  </label>

                  <button
                    type="button"
                    onClick={() => alert("Parolni tiklash yo'riqnomasi pochtangizga yuborildi.")}
                    className="text-blue-400 hover:text-blue-300 transition-colors font-medium cursor-pointer"
                  >
                    Parolni unutdingizmi?
                  </button>
                </div>

                {/* Submit Button */}
                <button
                  type="submit"
                  disabled={loading}
                  className="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all shadow-sm cursor-pointer disabled:opacity-50"
                >
                  {loading ? 'Kirilmoqda...' : 'Kirish'}
                </button>

              </form>

              {/* Toggle to Sign Up */}
              <div className="text-center text-xs text-slate-400 pt-2 border-t border-slate-800">
                Hisobingiz yo‘qmi?{' '}
                <button
                  type="button"
                  onClick={() => { setCurrentView('register'); setErrorMessage(null); setSuccessMessage(null); }}
                  className="text-blue-400 hover:text-blue-300 font-semibold transition-colors cursor-pointer ml-1"
                >
                  Ro‘yxatdan o‘tish
                </button>
              </div>

              {/* 1-Click Fast Candidate Demo Access */}
              <div className="pt-2 space-y-2">
                <span className="text-[11px] font-medium text-slate-500 block text-center">
                  Tezkor ko'rish uchun sinov profillari:
                </span>
                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={() => handleQuickDemo('Mansur Toshmatov', 'mansur@ieltix.uz')}
                    className="p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 border border-slate-700/60 text-left transition-colors cursor-pointer"
                  >
                    <span className="text-xs text-slate-200 font-medium block truncate">Mansur T.</span>
                    <span className="text-[10px] text-blue-400 block">Band 8.0 • VIP</span>
                  </button>

                  <button
                    type="button"
                    onClick={() => handleQuickDemo('Sardor Alimov', 'sardor@ieltix.uz')}
                    className="p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 border border-slate-700/60 text-left transition-colors cursor-pointer"
                  >
                    <span className="text-xs text-slate-200 font-medium block truncate">Sardor A.</span>
                    <span className="text-[10px] text-slate-400 block">Band 7.5 • Pro</span>
                  </button>
                </div>
              </div>

            </div>

          </div>
        )}

        {/* ========================================================================= */}
        {/* VIEW 3: CLEAN CENTERED REGISTRATION CARD */}
        {/* ========================================================================= */}
        {currentView === 'register' && (
          <div className="w-full max-w-md mx-auto animate-fadeIn">
            
            <div className="rounded-2xl bg-[#111726] border border-slate-800 p-6 sm:p-8 shadow-2xl shadow-black/40 space-y-5 text-left">
              
              <div className="text-center space-y-1.5">
                <h2 className="text-2xl font-bold tracking-tight text-white">
                  Ro‘yxatdan o‘tish
                </h2>
                <p className="text-xs text-slate-400">
                  IELTS yoki Milliy BBM darajangizni oshirishni boshlang
                </p>
              </div>

              {errorMessage && (
                <div className="p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs flex items-center gap-2">
                  <span className="material-symbols-outlined text-base shrink-0">error</span>
                  <span>{errorMessage}</span>
                </div>
              )}

              {successMessage && (
                <div className="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs flex items-center gap-2">
                  <span className="material-symbols-outlined text-base shrink-0">check_circle</span>
                  <span>{successMessage}</span>
                </div>
              )}

              <form onSubmit={handleRegisterSubmit} className="space-y-3.5">
                
                <div className="space-y-1">
                  <label className="text-xs font-medium text-slate-300 block">
                    Ism va familiya
                  </label>
                  <input
                    type="text"
                    required
                    value={regName}
                    onChange={(e) => setRegName(e.target.value)}
                    placeholder="Mansur Toshmatov"
                    className="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                </div>

                <div className="space-y-1">
                  <label className="text-xs font-medium text-slate-300 block">
                    Email manzili
                  </label>
                  <input
                    type="email"
                    required
                    value={regEmail}
                    onChange={(e) => setRegEmail(e.target.value)}
                    placeholder="nomzod@example.com"
                    className="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                </div>

                <div className="grid grid-cols-2 gap-3">
                  <div className="space-y-1">
                    <label className="text-xs font-medium text-slate-300 block">
                      Maqsadli Band
                    </label>
                    <select
                      value={regTargetBand}
                      onChange={(e) => setRegTargetBand(e.target.value)}
                      className="w-full px-3 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-xs sm:text-sm text-white focus:outline-none focus:border-blue-500 cursor-pointer"
                    >
                      <option value="7.0 Academic">Band 7.0</option>
                      <option value="7.5 Academic">Band 7.5</option>
                      <option value="8.0 Academic">Band 8.0</option>
                      <option value="8.5 Academic">Band 8.5</option>
                      <option value="9.0 Academic">Band 9.0</option>
                    </select>
                  </div>

                  <div className="space-y-1">
                    <label className="text-xs font-medium text-slate-300 block">
                      Imtihon Sanasi
                    </label>
                    <input
                      type="date"
                      value={regExamDate}
                      onChange={(e) => setRegExamDate(e.target.value)}
                      className="w-full px-3 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-xs sm:text-sm text-white focus:outline-none focus:border-blue-500"
                    />
                  </div>
                </div>

                <div className="space-y-1">
                  <label className="text-xs font-medium text-slate-300 block">
                    Imtihon Turi
                  </label>
                  <div className="grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      onClick={() => setRegMode('IELTS')}
                      className={`py-2 rounded-xl text-xs font-semibold transition-all border cursor-pointer ${
                        regMode === 'IELTS'
                          ? 'border-blue-500 bg-blue-600/20 text-blue-300'
                          : 'border-slate-700/80 bg-slate-900/40 text-slate-400 hover:text-white'
                      }`}
                    >
                      IELTS Academic
                    </button>
                    <button
                      type="button"
                      onClick={() => setRegMode('MILLIY_BBM')}
                      className={`py-2 rounded-xl text-xs font-semibold transition-all border cursor-pointer ${
                        regMode === 'MILLIY_BBM'
                          ? 'border-emerald-500 bg-emerald-600/20 text-emerald-300'
                          : 'border-slate-700/80 bg-slate-900/40 text-slate-400 hover:text-white'
                      }`}
                    >
                      Milliy BBM
                    </button>
                  </div>
                </div>

                <div className="space-y-1">
                  <label className="text-xs font-medium text-slate-300 block">
                    Parol
                  </label>
                  <input
                    type="password"
                    required
                    value={regPassword}
                    onChange={(e) => setRegPassword(e.target.value)}
                    placeholder="Kamida 6 ta belgi"
                    className="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/60 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all"
                  />
                </div>

                <button
                  type="submit"
                  disabled={loading}
                  className="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all shadow-sm cursor-pointer disabled:opacity-50 mt-2"
                >
                  {loading ? 'Yaratilmoqda...' : 'Ro‘yxatdan o‘tish'}
                </button>

              </form>

              <div className="text-center text-xs text-slate-400 pt-2 border-t border-slate-800">
                Hisobingiz bormi?{' '}
                <button
                  type="button"
                  onClick={() => { setCurrentView('login'); setErrorMessage(null); setSuccessMessage(null); }}
                  className="text-blue-400 hover:text-blue-300 font-semibold transition-colors cursor-pointer ml-1"
                >
                  Kirish
                </button>
              </div>

            </div>

          </div>
        )}

      </main>

      {/* 3. Minimalist Footer */}
      <footer className="w-full border-t border-slate-800/60 py-6 text-xs text-slate-500">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <span className="font-semibold text-slate-400">IELTIX</span>
            <span>•</span>
            <span>AI Exam Preparation Platform</span>
          </div>
          <p className="text-[11px] text-slate-500">
            Cambridge English & Milliy BBM baholash mezonlari asosida
          </p>
        </div>
      </footer>

    </div>
  );
};
